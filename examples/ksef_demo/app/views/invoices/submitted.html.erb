<% sub = @submission %>
<% error_body = sub.error.respond_to?(:body) && sub.error.body.is_a?(Hash) ? sub.error.body : nil %>
<%# An invoice rejection carries {"status" => {code, description, details}}; problem+json has a bare HTTP status. %>
<% rejection = error_body["status"] if error_body && error_body["status"].is_a?(Hash) %>
<% failure = if rejection then "KSeF rejected the invoice" elsif sub.outcome_unknown? then "Outcome unknown" else "Sending failed" end %>
<% content_for :title, sub.success? ? "Invoice accepted" : failure %>

<%# Hero %>
<section class="card overflow-hidden">
  <div class="flex flex-wrap items-center gap-6 p-6 sm:p-8 <%= sub.success? ? 'bg-gradient-to-br from-emerald-50 to-white' : 'bg-gradient-to-br from-rose-50 to-white' %>">
    <div class="grid size-16 shrink-0 place-items-center rounded-full <%= sub.success? ? 'bg-emerald-500' : 'bg-rose-500' %> text-white shadow-lg">
      <%= icon(sub.success? ? :check : :x, "size-8") %>
    </div>
    <div class="min-w-0 flex-1">
      <% if sub.success? %>
        <h1 class="text-2xl font-bold text-slate-900">Invoice accepted by KSeF</h1>
        <p class="mt-1 text-sm text-slate-500">Assigned KSeF number</p>
        <div class="mt-1 flex flex-wrap items-center gap-2">
          <span class="font-mono text-lg font-semibold break-all text-emerald-800"><%= sub.ksef_number %></span>
          <%= copy_button(sub.ksef_number, label: "Copy") %>
        </div>
      <% else %>
        <h1 class="text-2xl font-bold text-slate-900"><%= failure %></h1>
        <p class="mt-1 text-sm text-slate-600">
          Step “<%= sub.failed_step&.label %>”:
          <% if rejection %>
            <%= status_badge(rejection["code"], rejection["description"]) %>
          <% elsif sub.error.is_a?(Ksef::SchemaValidationError) && sub.error.messages.present? %>
            the document does not match the FA(3) schema (<%= pluralize(sub.error.messages.size, "error") %>).
          <% else %>
            <%= sub.error.message %>
          <% end %>
        </p>
      <% end %>
    </div>
    <div class="flex flex-wrap gap-2">
      <% if sub.success? %>
        <%= link_to "Download UPO", invoice_upo_session_path(sub.session_reference, sub.invoice_reference), class: "btn-success" %>
        <% if sub.ksef_number %><%= link_to "Invoice XML", download_invoices_path(sub.ksef_number), class: "btn-secondary" %><% end %>
      <% end %>
      <%= link_to "Issue another", new_invoice_path, class: "btn-primary" %>
    </div>
  </div>
</section>

<div class="grid gap-6 <%= 'lg:grid-cols-3' if @qr %>">
  <%# Timeline %>
  <section class="card card-body lg:col-span-2">
    <h2 class="card-title mb-5">What happened</h2>
    <ol class="relative space-y-6 border-l-2 border-slate-100 pl-8">
      <% sub.steps.each do |step| %>
        <% dot = { done: "bg-emerald-500 text-white", failed: "bg-rose-500 text-white", pending: "bg-white text-slate-300 ring-2 ring-slate-200", running: "bg-sky-500 text-white" }[step.status] %>
        <li class="relative">
          <span class="absolute top-0 -left-[2.6rem] grid size-7 place-items-center rounded-full <%= dot %>">
            <%= step.status == :failed ? icon(:x, "size-4") : icon(:check, "size-4") %>
          </span>
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <span class="font-medium <%= step.status == :pending ? 'text-slate-400' : 'text-slate-900' %>"><%= step.label %></span>
            <% if step.duration_ms %><span class="font-mono text-xs text-slate-400"><%= step.duration_ms >= 1000 ? "#{(step.duration_ms / 1000.0).round(1)} s" : "#{step.duration_ms} ms" %></span><% end %>
          </div>
          <% if step.detail.present? %><p class="mt-0.5 font-mono text-xs break-all text-slate-500"><%= step.detail %></p><% end %>
          <% if step.status == :pending %><p class="mt-0.5 text-xs text-slate-400">not reached</p><% end %>
        </li>
      <% end %>
    </ol>
  </section>

  <%# QR %>
  <% if @qr %>
  <section class="card card-body flex flex-col items-center text-center">
    <h2 class="card-title self-start">Verification QR (CODE I)</h2>
      <div class="mt-4 mb-4 w-52 rounded-lg bg-white p-2 ring-1 ring-slate-200 [&_svg]:h-auto [&_svg]:w-full"><%= raw @qr[:svg] %></div>
      <div class="flex max-w-full items-center gap-1">
        <a href="<%= @qr[:url] %>" target="_blank" rel="noopener" class="truncate font-mono text-xs text-indigo-600"><%= @qr[:url] %></a>
        <%= copy_button(@qr[:url]) %>
      </div>
      <p class="hint">Printed on the invoice with the KSeF number below it; scanning opens the Ministry's verification page.</p>
  </section>
  <% end %>
</div>

<% if sub.error %>
  <section class="card card-body space-y-4 ring-rose-200">
    <h2 class="card-title text-rose-800">Error details</h2>
    <% if (details = Array(rejection&.dig("details"))).any? %>
      <div class="rounded-lg bg-rose-50 p-4">
        <div class="text-sm font-semibold text-rose-800">KSeF says (status.details):</div>
        <ul class="mt-2 list-disc space-y-1 pl-5 font-mono text-xs text-rose-900"><% details.each do |d| %><li><%= d %></li><% end %></ul>
      </div>
    <% end %>
    <% if sub.error.is_a?(Ksef::SchemaValidationError) && sub.error.messages.present? %>
      <div class="rounded-lg bg-rose-50 p-4">
        <div class="text-sm font-semibold text-rose-800">Local XSD validator:</div>
        <ul class="mt-2 list-disc space-y-1 pl-5 font-mono text-xs text-rose-900"><% sub.error.messages.each do |m| %><li><%= m %></li><% end %></ul>
        <p class="mt-2 text-xs text-rose-700">Nothing was sent. Tick “Skip local XSD validation” to see how KSeF itself reacts.</p>
      </div>
    <% end %>
    <%= tag.details(open: rejection.nil? && !sub.error.is_a?(Ksef::SchemaValidationError)) do %>
      <summary class="cursor-pointer text-sm text-slate-500 hover:text-slate-900">Technical details</summary>
      <div class="mt-2"><%= render_value(describe_error(sub.error)) %></div>
    <% end %>
    <% if sub.outcome_unknown? %>
      <div class="rounded-lg bg-amber-50 p-4 text-sm text-amber-900 ring-1 ring-amber-200">
        KSeF may have received the invoice and may still accept it. <strong>Check the session before sending it again</strong> —
        another send gets a new <code>FV/DEMO/…</code> number and would be a second invoice.
      </div>
    <% end %>
    <% if sub.session_reference %>
      <p class="text-sm"><%= link_to "Open session #{sub.session_reference} →", session_path(sub.session_reference), class: "font-semibold text-indigo-600" %> (failed invoices, status)</p>
    <% end %>
  </section>
<% end %>

<section class="card card-body">
  <h2 class="card-title mb-3">References</h2>
  <%= render_value({ "session" => sub.session_reference, "invoice reference" => sub.invoice_reference,
                     "invoice hash (SHA-256)" => sub.invoice_hash, "KSeF number" => sub.ksef_number }) %>
  <% if sub.session_reference %><p class="mt-3 text-sm"><%= link_to "Session details →", session_path(sub.session_reference), class: "font-semibold text-indigo-600" %></p><% end %>
  <details class="mt-4">
    <summary class="cursor-pointer text-sm text-slate-500 hover:text-slate-900">XML that was sent</summary>
    <div class="mt-2"><%= code_block(sub.xml) %></div>
  </details>
  <% if sub.upo %>
    <details class="mt-2">
      <summary class="cursor-pointer text-sm text-slate-500 hover:text-slate-900">UPO (official receipt, signed by the Ministry of Finance)</summary>
      <div class="mt-2"><%= code_block(sub.upo) %></div>
    </details>
  <% end %>
</section>

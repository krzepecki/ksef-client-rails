<%= render "shared/page_header", title: "Session", subtitle: params[:reference] %>

<% if @outcome&.error %><%= render "shared/outcome" %><% end %>

<% if @status %>
  <div class="grid gap-4 sm:grid-cols-4">
    <div class="card p-5"><div class="text-xs text-slate-500">Status</div><div class="mt-2"><%= status_badge(@status.dig("status", "code"), @status.dig("status", "description")) %></div></div>
    <div class="card p-5"><div class="text-xs text-slate-500">Invoices</div><div class="mt-1 text-2xl font-bold tabular-nums"><%= @status["invoiceCount"].to_i %></div></div>
    <div class="card p-5"><div class="text-xs text-slate-500">Accepted</div><div class="mt-1 text-2xl font-bold text-emerald-700 tabular-nums"><%= @status["successfulInvoiceCount"].to_i %></div></div>
    <div class="card p-5"><div class="text-xs text-slate-500">Rejected</div><div class="mt-1 text-2xl font-bold text-rose-700 tabular-nums"><%= @status["failedInvoiceCount"].to_i %></div></div>
  </div>

  <% if (pages = Array(@status.dig("upo", "pages"))).any? %>
    <%= render "shared/card", title: "Session UPO", subtitle: "Aggregate receipt for the whole session." do %>
      <div class="flex flex-wrap gap-2">
        <% pages.each_with_index do |page, i| %>
          <%= link_to "Download UPO #{pages.size > 1 ? "page #{i + 1}" : ''}", upo_session_path(params[:reference], page["referenceNumber"]), class: "btn-success" %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%= render "shared/card", title: "Invoices" do %>
    <% if @invoices.blank? %>
      <p class="text-sm text-slate-500">No invoices in this session (yet — batch sessions are processed asynchronously; refresh in a moment).</p>
    <% else %>
      <div class="overflow-x-auto rounded-lg ring-1 ring-slate-200">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
          <thead class="bg-slate-50 text-left text-xs text-slate-600"><tr><th class="px-3 py-2">#</th><th class="px-3 py-2">Number</th><th class="px-3 py-2">KSeF number</th><th class="px-3 py-2">Status</th><th class="px-3 py-2">Accepted</th><th></th></tr></thead>
          <tbody class="divide-y divide-slate-100">
            <% @invoices.each do |inv| %>
              <tr class="align-top">
                <td class="px-3 py-2 text-slate-400"><%= inv["ordinalNumber"] %></td>
                <td class="px-3 py-2 font-medium"><%= inv["invoiceNumber"] || inv["invoiceFileName"] %></td>
                <td class="px-3 py-2 font-mono text-xs"><%= inv["ksefNumber"] || "—" %></td>
                <td class="px-3 py-2"><%= status_with_details(inv["status"]) if inv["status"] %></td>
                <td class="px-3 py-2 whitespace-nowrap"><%= format_time(inv["invoicingDate"] || inv["acquisitionDate"]) %></td>
                <td class="px-3 py-2 text-right whitespace-nowrap">
                  <% if inv.dig("status", "code") == 200 %>
                    <%= link_to "UPO", invoice_upo_session_path(params[:reference], inv["referenceNumber"]), class: "font-semibold text-indigo-600" %>
                    <% if inv["ksefNumber"] %> · <%= link_to "XML", download_invoices_path(inv["ksefNumber"]), class: "text-indigo-600" %><% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>

  <% if @failed.present? %>
    <%= render "shared/card", title: "Rejected invoices", subtitle: "GET /sessions/{ref}/invoices/failed — status.details names the rule that failed.", css: "ring-rose-200" do %>
      <%= render_value(@failed) %>
    <% end %>
  <% end %>

  <details class="card card-body"><summary class="cursor-pointer text-sm font-medium">Raw session status</summary><div class="mt-3"><%= render_value(@status) %></div></details>
<% end %>
